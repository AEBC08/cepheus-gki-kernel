# cepheus bring-up：SM8150 平台驱动（D014 的 B1 批次：时钟）
#
# 注意：本文件与 config/bringup-lite.config 一起使用（逗号分隔传给 DEVICE_CONFIGS）。
#
# 说明：
#   - gcc/gpucc/videocc-sm8150 在 ACK 5.10 里已有（上游实现），直接启用；
#   - camcc/dispcc/npucc/scc-sm8150 由 kernel/overlay 提供（来自 5.4 前移树），
#     通过 kernel/patches/0002 登记到 drivers/clk/qcom/{Kconfig,Makefile}；
#   - 全部用 =y（内置）：我们没有 vendor_boot/vendor_dlkm 的模块加载链。
#
# 本文件会随 B2/B3/B4 批次持续扩充。

CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_SM_GCC_8150=y
CONFIG_SM_GPUCC_8150=y
CONFIG_SM_VIDEOCC_8150=y
CONFIG_SM_CAMCC_8150=y
CONFIG_SM_DISPCC_8150=y
CONFIG_SM_NPUCC_8150=y
CONFIG_SM_SCC_8150=y

# --- B2：pinctrl（复用 ACK 上游驱动，不移植） ---
# 依据：我们 DT 的 `qcom,sm8150-pinctrl` 与 ACK `drivers/pinctrl/qcom/pinctrl-sm8150.c`
# 的 of_match 完全一致；上游驱动自带完整 SM8150 pin/function/group 表（npins=ARRAY_SIZE(sm8150_pins)），
# 因此判定"复用上游"，只打开配置（证据见 memory/findings/F014）。
CONFIG_PINCTRL_SM8150=y
# 影响面锁定：其它 SoC 的 pinctrl 不编译
# CONFIG_PINCTRL_SM8250 is not set

# --- B3：interconnect + LLCC ---
# QCOM_RPMH 是 INTERCONNECT_QCOM_RPMH_POSSIBLE 的前置条件（Kconfig: depends on QCOM_RPMH），
# 不开它 CONFIG_INTERCONNECT_QCOM_SM8150 会被 merge_config 静默丢弃。
# 同一个依赖也卡住了 B1 的 CONFIG_QCOM_CLK_RPMH（见 F013 §3）。
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8150=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y

# LLCC：ACK 上游只有 sc7180 数据表，SM8150 的切片表由 overlay 前移（D015 登记，见 F015）
CONFIG_QCOM_LLCC=y

# 影响面锁定（D015 约束 2）：只编译 SM8150 系的 clk 驱动，
# 避免 CAF clk 框架覆盖波及其它 SoC（gki_defconfig 默认不启用这些，显式写出便于审计）
# CONFIG_SM_GCC_8250 is not set
# CONFIG_SM_GPUCC_8250 is not set
# CONFIG_SM_VIDEOCC_8250 is not set
# CONFIG_SM_DISPCC_8250 is not set
