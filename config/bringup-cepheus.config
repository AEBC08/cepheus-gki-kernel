# cepheus bring-up：SM8150 平台驱动（D014 的 B1 批次：时钟）
#
# 注意：本文件与 config/bringup-lite.config 一起使用（逗号分隔传给 DEVICE_CONFIGS）。
#
# 说明：
#   - gcc/gpucc/videocc-sm8150 在 ACK 5.10 里已有（上游实现），直接启用；
#   - camcc/dispcc/npucc/scc-sm8150 由 kernel/overlay 提供（来自 5.4 前移树），
#     通过 kernel/patches/0002 登记到 drivers/clk/qcom/{Kconfig,Makefile}；
#   - 全部用 =y（内置）：我们没有 vendor_boot/vendor_dlkm 的模块加载链。
#
# 本文件会随 B2/B3/B4 批次持续扩充。

CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_SM_GCC_8150=y
CONFIG_SM_GPUCC_8150=y
CONFIG_SM_VIDEOCC_8150=y
CONFIG_SM_CAMCC_8150=y
CONFIG_SM_DISPCC_8150=y
CONFIG_SM_NPUCC_8150=y
CONFIG_SM_SCC_8150=y
