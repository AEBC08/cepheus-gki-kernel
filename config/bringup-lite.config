# cepheus GKI 5.10 bring-up：关闭重量级构建选项（临时）

# 存在理由见 memory/decisions/D009-bringup-config-fix.md
#
# ACK android12-5.10 的 gki_defconfig 面向"可调试的 GKI 产物"，默认打开了一批在
# 4 vCPU runner 上极其昂贵的选项（已核对 gki_defconfig 原文）：
#
#   LTO_CLANG_FULL    full LTO，链接阶段单线程，30 分钟以上
#   CFI_CLANG         CFI，依赖 LTO，额外插桩
#   KASAN (+ HW_TAGS) 内存检查，编译时间与内存成倍上升
#   DEBUG_INFO        DWARF4 调试信息，产物体积与磁盘占用大户
#
# 注意（重要，踩过坑）：LTO 在 5.10 是 choice（arch/Kconfig），候选为 LTO_NONE /
# LTO_CLANG_FULL / LTO_CLANG_THIN，默认 LTO_NONE。**必须显式写 CONFIG_LTO_NONE=y**；
# 写 "# CONFIG_LTO is not set" 之类是无效的，因为 LTO / LTO_CLANG 只是被 select 的
# 隐藏符号。
#
# 另：merge_config.sh 会把 `# CONFIG_FOO is not set` 之外、提到 CONFIG_ 的注释行
# 当成上一个符号的值一起吞掉，产生噪声警告。因此本文件的注释里**不写**
# "CONFIG_xxx=y" 这种形式，避免被误解析。
#
# 本文件仅用于 bring-up（S1/S2）。S3 收尾前必须移除并恢复 GKI 默认形态。

# LTO：选择 NONE，并显式关掉两个 Clang LTO 选项
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_LTO_CLANG_THIN is not set

# CFI 依赖 LTO；LTO 关掉后本就不可用，显式写出以便审计
# CONFIG_CFI_CLANG is not set

# KASAN 是 menuconfig（lib/Kconfig.kasan），关掉后其子选项自动失效
# CONFIG_KASAN is not set

# 调试信息：体积与时间大户，bring-up 阶段不需要
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
