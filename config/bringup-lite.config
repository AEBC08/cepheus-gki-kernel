# cepehus GKI 5.10 bring-up：关闭重量级构建选项（临时）

# 存在理由见 memory/decisions/D009-bringup-config-fix.md
#
# ACK android12-5.10 的 gki_defconfig 面向"可调试的 GKI 产物"，默认打开了一批
# 在 4 vCPU runner 上极其昂贵的选项（已核对 gki_defconfig 原文）：
#
#   CONFIG_LTO_CLANG_FULL=y      full LTO，链接阶段单线程，>30 分钟
#   CONFIG_CFI_CLANG=y           CFI，依赖 LTO，额外插桩
#   CONFIG_KASAN=y               KASAN（+ KASAN_HW_TAGS），编译时间与内存翻数倍
#   CONFIG_DEBUG_INFO=y          DWARF4 调试信息，产物体积与磁盘占用大户
#
# 说明：LTO 在 5.10 是 choice（arch/Kconfig），候选为 LTO_CLANG_FULL /
# LTO_CLANG_THIN / LTO_NONE，默认 LTO_NONE。**必须显式写 CONFIG_LTO_NONE=y**，
# 写 "# CONFIG_LTO is not set" 是无效的（LTO 只是被 select 的隐藏符号）。
#
# 本文件仅用于 bring-up（S1/S2）。S3 收尾前必须移除并恢复 GKI 默认形态。

# LTO：选择 NONE，并显式关掉两个 Clang LTO 选项
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_LTO_CLANG_THIN is not set

# CFI 依赖 LTO；LTO 关掉后本就不可用，显式写出以便审计
# CONFIG_CFI_CLANG is not set

# KASAN 是 menuconfig（lib/Kconfig.kasan），关掉后其子选项自动失效
# CONFIG_KASAN is not set

# 调试信息：体积与时间大户，bring-up 阶段不需要
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
