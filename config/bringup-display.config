# cepheus B4：CAF techpack/display 参与编译（bring-up 探针）
#
# 存在理由见 memory/findings/F016 与 kernel/patches/0006。
#
# 开关来源，按顺序：
#   1. CONFIG_DISPLAY_BUILD  —— 本文件，patch 0006 的入口开关（obj-y += techpack/display/）
#   2. CONFIG_DRM_MSM*       —— display-drivers 自己的 config/lahainadisp.conf 清单
#
# 说明（重要）：
#   - 这一组开关**只用于 B4 的编译探针**，不进入默认构建的片段列表；
#     CI 里要显式传 with_display_techpack=1 且把本文件加进 device_configs。
#   - 之所以用 lahainadisp.conf 而不是 sm8150 专属清单：display-drivers 的 5.10 分支
#     没有 sm8150disp.conf，lahaina 与 sm8150 同属 5.10 一代，配置项是同一套。
#   - ACK 的 gki_defconfig 里 CONFIG_DRM 是 =y，CONFIG_DRM_MSM 在 arm64 qcom 上默认未开
#     （ACK 的 DRM_MSM 面向 sc7180/sdm845 上游面板栈，与 CAF 的 msm/ 驱动同名但不同实现），
#     因此这里显式打开会与 ACK 的 drivers/gpu/drm/msm 冲突，需要 0007 补丁处理；
#     本轮先只验证"源码能进树、能被 kbuild 找到"，见 F016 的判定。

CONFIG_DISPLAY_BUILD=y

# display-drivers 的驱动开关
CONFIG_DRM_MSM_SDE=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DSI_PARSER=y
CONFIG_DRM_SDE_WB=y
CONFIG_DRM_MSM_REGISTER_LOGGING=y
CONFIG_QCOM_MDSS_PLL=y
CONFIG_DRM_SDE_RSC=y
CONFIG_SYNC_FILE=y
